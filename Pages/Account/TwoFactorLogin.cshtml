@page
@model TwoFactorLoginModel
@{
    ViewData["Title"] = "Двухфакторная аутентификация";
}
<h2>Введите код из приложения</h2>
<form method="post">
    <div asp-validation-summary="All"></div>
    <label asp-for="Code">6-значный код</label>
    <input asp-for="Code" maxlength="6" autocomplete="one-time-code" />
    <span asp-validation-for="Code"></span>
    <button type="submit">Подтвердить</button>
</form>
