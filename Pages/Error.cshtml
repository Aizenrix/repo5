@page "/Error/{code:int}"
@model ErrorModel
@{
    ViewData["Title"] = $"Ошибка {Model.Code}";
}

<div class="error-container">
    <div class="error-code">@Model.Code</div>
    <div class="error-icon">@Model.Icon</div>
    <h1 class="error-title">@Model.Title</h1>
    <p class="error-message">@Model.Message</p>
    <div class="error-actions">
        @if (Model.Code == 401)
        {
            <a href="/Account/Login" class="btn btn-primary">Войти</a>
        }
        else if (Model.Code == 403)
        {
            <a href="/" class="btn btn-primary">На главную</a>
            @if (!User.Identity!.IsAuthenticated)
            {
                <a href="/Account/Login" class="btn btn-secondary">Войти</a>
            }
        }
        else
        {
            <a href="/" class="btn btn-primary">На главную</a>
            <a href="javascript:history.back()" class="btn btn-secondary">Назад</a>
        }
    </div>
</div>

<style>
    .error-container {
        text-align: center;
        padding: 60px 20px;
        max-width: 500px;
        margin: 0 auto;
    }
    .error-code {
        font-size: 120px;
        font-weight: bold;
        color: #e74c3c;
        line-height: 1;
        margin-bottom: 0;
    }
    .error-icon {
        font-size: 48px;
        margin: 10px 0;
    }
    .error-title {
        font-size: 28px;
        margin: 10px 0;
        color: #2c3e50;
    }
    .error-message {
        color: #7f8c8d;
        font-size: 16px;
        margin-bottom: 30px;
    }
    .error-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
    }
    .btn {
        padding: 10px 24px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 15px;
        font-weight: 500;
        display: inline-block;
    }
    .btn-primary {
        background: #3498db;
        color: white;
    }
    .btn-primary:hover { background: #2980b9; }
    .btn-secondary {
        background: #ecf0f1;
        color: #2c3e50;
    }
    .btn-secondary:hover { background: #dde1e3; }
</style>
