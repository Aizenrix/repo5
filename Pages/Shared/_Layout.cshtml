@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TodoManager</title>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(ViewContext.HttpContext).RequestToken" />
    }
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span>Привет, @User.Identity.Name!</span>
            <a href="/Tasks">Задачи</a>
            @if (User.IsInRole("Admin"))
            {
                <a href="/Admin">Админ-панель</a>
            }
            <a href="/Account/Profile">Профиль</a>
            <form method="post" asp-page="/Account/Logout" style="display:inline">
                @Html.AntiForgeryToken()
                <button type="submit">Выйти</button>
            </form>
        }
        else
        {
            <a href="/Account/Login">Войти</a>
            <a href="/Account/Register">Зарегистрироваться</a>
        }
    </nav>
    <main>
        @RenderBody()
    </main>
    <script src="~/js/site.js"></script>
</body>
</html>
